{
  "name": "collabo",
  "version": "0.1.0",
  "private": true,
  "description": "Two-sided influencer marketing marketplace: businesses shop creators, creators sell packages at market rates.",
  "type": "module",
  "scripts": {
    "dev:server": "node --watch --no-warnings=ExperimentalWarning server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --no-warnings=ExperimentalWarning server/index.js",
    "seed": "node --no-warnings=ExperimentalWarning server/seed.js",
    "test": "node --no-warnings=ExperimentalWarning --test test/*.test.js",
    "lighthouse": "npx --yes lighthouse@13.5.0 http://localhost:3001/ --quiet --chrome-flags=\"--headless=new --no-sandbox\" --only-categories=performance,accessibility,best-practices,seo --view=false --output=html --output-path=./lighthouse.html"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "compression": "1.8.2",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "clsx": "2.1.1",
    "framer-motion": "14.7.1",
    "lucide-react": "1.62.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "vite": "^6.0.7"
  }
}
